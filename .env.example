# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Database (Supabase PostgreSQL connection string)
DATABASE_URL=postgresql://postgres:password@db.your-project.supabase.co:5432/postgres

# Stripe
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_PRICE_STARTER=price_...

# Fly.io
FLY_API_TOKEN=your-fly-api-token
FLY_ORG=personal

# OpenClaw
OPENCLAW_DOCKER_IMAGE=ghcr.io/openclaw/openclaw:latest
# Optional: pre-configure AI API keys so tenant instances work out of the box
OPENCLAW_DEFAULT_ANTHROPIC_KEY=sk-ant-...
OPENCLAW_DEFAULT_OPENAI_KEY=sk-...
OPENCLAW_DEFAULT_OPENROUTER_KEY=sk-or-...   # OpenRouter API key for tenant instances
OPENCLAW_DEFAULT_MODEL=openrouter/moonshotai/kimi-k2.5  # Default model for new instances

# PostHog Analytics
NEXT_PUBLIC_POSTHOG_KEY=phc_...
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000

# E2E Testing (optional — only needed for running Playwright tests)
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key  # Required for authed tests (Tier 2)
# E2E_BASE_URL=https://tryopenclaw.vercel.app      # Omit to test against local dev server
